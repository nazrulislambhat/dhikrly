# Copy this file to .env.local and replace the placeholder values.
# Required for Supabase auth + sync features.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# VAPID keys for browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:hello@dhikrly.app

# Optional but used by cron + app links.
CRON_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
