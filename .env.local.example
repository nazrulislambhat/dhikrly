# ── NEON POSTGRESQL (Drizzle ORM Connection Pool) ──
# From Neon Dashboard -> Project -> Connection Details -> Pooled connection string
DATABASE_URL=postgresql://user:password@ep-placeholder-pooler.neon.tech/dhikrly?sslmode=require

# ── UPSTASH REDIS (Rate Limiting & In-Memory Cache) ──
# From Upstash Dashboard -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=https://placeholder.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ── DECOUPLED AUTH & SESSION SECRET ──
AUTH_SECRET=generate-a-secure-32-byte-random-secret

# VAPID keys for browser push notifications.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:hello@dhikrly.app

# Optional but used by cron + app links.
CRON_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy Supabase (Optional during transition phase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
